PORT=5000
MONGODB_URI=
JWT_SECRET=dgdf_dev_secret_change_me
# Minutes of portal inactivity before the session expires (sliding — resets on /auth/heartbeat)
# Must match dgdf-admin's VITE_IDLE_TIMEOUT_MINUTES
IDLE_TIMEOUT_MINUTES=
# Used by: npm run seed:admin
ADMIN_EMAIL=admin@dgdelightfound.org
ADMIN_PASSWORD=admin123
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required for donations — set webhook URL in Paystack to POST /api/donations/webhook
PAYSTACK_SECRET_KEY=
CLIENT_URL=http://localhost:3000
# Public Next.js site URL used to bust CMS cache after admin updates
PUBLIC_WEB_URL=http://localhost:3000
# Must match public-web REVALIDATE_SECRET
REVALIDATE_SECRET=change_me_revalidate_secret
ADMIN_URL=http://localhost:5173

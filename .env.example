PORT=
MONGODB_URI=
JWT_SECRET=secret_change_me
# Minutes of portal inactivity before the session expires (sliding — resets on /auth/heartbeat)
# Must match dgdf-admin's VITE_IDLE_TIMEOUT_MINUTES
IDLE_TIMEOUT_MINUTES=
# Used by: npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=
# Required for donations — set webhook URL in Paystack to POST /api/donations/webhook
PAYSTACK_SECRET_KEY=
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Used to send password-reset emails via nodemailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="DGDF Admin <no-reply@dgdfoundation.org>"
